<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      デジタル庁デザインシステム（DADS）を基準とした共通スタイル（第17章）。
      色の値は @digital-go-jp/design-tokens 2.1.0 の primitive / semantic トークン。
      ハイコントラスト時は App.ApplyHighContrast がブラシを OS の色へ差し替える。
    -->

    <!-- Color tokens -->
    <Color x:Key="Blue50">#E8F1FE</Color>
    <Color x:Key="Blue100">#D9E6FF</Color>
    <Color x:Key="Blue200">#C5D7FB</Color>
    <Color x:Key="Blue900">#0017C1</Color>
    <Color x:Key="Blue1000">#00118F</Color>
    <Color x:Key="Blue1200">#000060</Color>
    <Color x:Key="Gray50">#F2F2F2</Color>
    <Color x:Key="Gray100">#E6E6E6</Color>
    <Color x:Key="Gray200">#CCCCCC</Color>
    <Color x:Key="Gray536">#767676</Color>
    <Color x:Key="Gray600">#666666</Color>
    <Color x:Key="Gray800">#333333</Color>
    <Color x:Key="Gray900">#1A1A1A</Color>
    <Color x:Key="Success2">#197A4B</Color>
    <Color x:Key="Green50">#E6F5EC</Color>
    <Color x:Key="Error2">#CE0000</Color>
    <Color x:Key="Red50">#FDEEEE</Color>
    <Color x:Key="WarningYellow2">#927200</Color>
    <Color x:Key="Yellow50">#FBF5E0</Color>
    <Color x:Key="Yellow300">#FFD43D</Color>

    <!-- Semantic brushes（コードからも差し替えるため DynamicResource で参照する） -->
    <SolidColorBrush x:Key="Brush.Background" Color="White" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Gray50}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Brush.TextSub" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Gray536}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Blue900}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Blue1000}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Blue1200}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="White" />
    <SolidColorBrush x:Key="Brush.SecondaryHover" Color="{StaticResource Blue100}" />
    <SolidColorBrush x:Key="Brush.SecondaryPressed" Color="{StaticResource Blue200}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Blue50}" />
    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Brush.DisabledFg" Color="{StaticResource Gray536}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Success2}" />
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="{StaticResource Green50}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Error2}" />
    <SolidColorBrush x:Key="Brush.ErrorBg" Color="{StaticResource Red50}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource WarningYellow2}" />
    <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Yellow50}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Blue900}" />
    <SolidColorBrush x:Key="Brush.InfoBg" Color="{StaticResource Blue50}" />
    <SolidColorBrush x:Key="Brush.FocusOuter" Color="{StaticResource Yellow300}" />
    <SolidColorBrush x:Key="Brush.FocusInner" Color="Black" />

    <!-- Typography / spacing（DIP。DADS の rem 値を 1rem = 16 DIP で換算） -->
    <FontFamily x:Key="Font.Sans">Noto Sans JP, BIZ UDPGothic, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Size.Body">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Size.Small">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Size.H1">28</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Size.H2">20</sys:Double>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>

    <!-- フォーカス表示：黒の内枠＋Yellow-300 の外枠（DADS） -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4">
                        <Rectangle Stroke="{DynamicResource Brush.FocusOuter}" StrokeThickness="4" RadiusX="10" RadiusY="10" />
                        <Rectangle Margin="3" Stroke="{DynamicResource Brush.FocusInner}" StrokeThickness="2" RadiusX="8" RadiusY="8" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window" x:Key="AppWindow">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.H1}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.H2}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,12,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Help" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSub}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- ボタン：既定は副操作（アウトライン） -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SecondaryHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SecondaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DisabledBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledFg}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作（塗り） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DisabledBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="24" Height="24" CornerRadius="4" BorderThickness="2"
                                BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Background}" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Path x:Name="Mark" Data="M 4,12 L 10,18 L 20,6" Stroke="{DynamicResource Brush.OnPrimary}" StrokeThickness="3"
                                  Visibility="Collapsed" Margin="-2" Stretch="None" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.DisabledBg}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="24" Height="24" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.Border}" StrokeThickness="2" Fill="{DynamicResource Brush.Background}" />
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource Brush.Primary}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Focus" Margin="-4" CornerRadius="10" BorderThickness="4" BorderBrush="{DynamicResource Brush.FocusOuter}" Visibility="Collapsed" />
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusInner}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DisabledBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
    </Style>

    <!-- 一覧（テーブル） -->
    <Style TargetType="DataGrid">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="40" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.FocusInner}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.FocusOuter}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
