<Window x:Class="WindowRescue.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WindowRescue.Localization"
        Style="{StaticResource AppWindow}"
        Title="{l:T About_Title}"
        Width="760" Height="600" MinWidth="420" MinHeight="400"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/WindowRescue.ico">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Surface}" Padding="16" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/WindowRescue-256.png" Width="64" Height="64"
                       VerticalAlignment="Top" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding ProductName}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ProductName}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="{l:T About_Version}" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="{l:T About_Company}" /><Run Text="{Binding Company, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Copyright}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://github.com/fa-yoshinobu/window-rescue" RequestNavigate="OpenLink"
                                   Foreground="{DynamicResource Brush.Primary}">
                            GitHub：fa-yoshinobu/window-rescue
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,16,0,16">
            <TabItem Header="{Binding [About_Libraries], Source={x:Static l:Loc.Instance}}">
                <ListView ItemsSource="{Binding Libraries}" Margin="0,8,0,0" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{Binding [About_Libraries], Source={x:Static l:Loc.Instance}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [About_ColName], Source={x:Static l:Loc.Instance}}" Width="200" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{Binding [About_ColVersion], Source={x:Static l:Loc.Instance}}" Width="100" DisplayMemberBinding="{Binding Version}" />
                            <GridViewColumn Header="{Binding [About_ColLicense], Source={x:Static l:Loc.Instance}}" Width="100" DisplayMemberBinding="{Binding License}" />
                            <GridViewColumn Header="{Binding [About_ColPurpose], Source={x:Static l:Loc.Instance}}" Width="260" DisplayMemberBinding="{Binding Purpose}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="{Binding [About_License], Source={x:Static l:Loc.Instance}}">
                <TextBox Text="{Binding LicenseText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Margin="0,8,0,0"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas, BIZ UDGothic" FontSize="14"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding [About_License], Source={x:Static l:Loc.Instance}}" />
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="100"
                IsCancel="True" IsDefault="True" Click="CloseWindow">
            <TextBlock Text="{l:T About_Close}" />
        </Button>
    </Grid>
</Window>
