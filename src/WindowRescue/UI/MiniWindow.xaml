<Window x:Class="WindowRescue.UI.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WindowRescue.Localization"
        Style="{StaticResource AppWindow}"
        Title="{l:T App_Name}"
        WindowStyle="ToolWindow" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontSize="{DynamicResource Size.Small}"
        Icon="pack://application:,,,/Assets/WindowRescue.ico">
    <StackPanel Margin="16,12,16,16" MinWidth="240" MaxWidth="320">
        <TextBlock x:Name="DisplayText" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <CheckBox x:Name="PinCheck" Checked="Pin_Changed" Unchecked="Pin_Changed">
            <TextBlock Text="{l:T Mini_PinNew}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox x:Name="TinyCheck" Checked="Tiny_Changed" Unchecked="Tiny_Changed">
            <TextBlock Text="{l:T Mini_FixTiny}" TextWrapping="Wrap" />
        </CheckBox>
        <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="Gather_Click">
            <TextBlock Text="{l:T Mini_Gather}" />
        </Button>
    </StackPanel>
</Window>
